+void CoopLogPowerChange(i32 seat, f32 before)
+{
+    const f32 after = g_GameManager.Power(seat);
+    if (before < 128.0f && after >= 128.0f)
+        CoopLog("POWER_FULL seat=%d power=%d", seat, (i32)after);
+    if (before >= 32.0f && after < 32.0f)
+        CoopLog("POWER_LOW seat=%d power=%d", seat, (i32)after);
+}
+
+void CoopLogSpellFailure(const char *reason, i32 seat)
+{
+    if (g_EnemyManager.spellcardInfo.isActive && g_EnemyManager.spellcardInfo.isCapturing)
+        CoopLog("SPELL_FAILED stage=%d spell=%d seat=%d reason=%s", g_GameManager.currentStage,
+                g_EnemyManager.spellcardInfo.spellcardIdx, seat, reason);
