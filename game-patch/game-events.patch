+static void GivePowerToBot(int seat)
+{
+    Player *self = &g_Players[seat];
+    if (IsGhost(self)) return;
+    f32 &power = g_GameManager.Power(seat);
+    if ((i32)power < 20) return;
+    int best = -1;
+    f32 bestD = 1e30f;
+    for (int other = 0; other < PlayerCount(); other++)
+    {
+        if (other == seat) continue;
+        Player *mate = &g_Players[other];
+        if (IsGhost(mate)) continue;
+        if ((i32)g_GameManager.Power(other) >= 128) continue;
+        f32 dx = mate->positionCenter.x - self->positionCenter.x;
+        f32 dy = mate->positionCenter.y - self->positionCenter.y;
+        f32 d = dx * dx + dy * dy;
+        if (d < bestD) { bestD = d; best = other; }
+    }
+    if (best < 0) return;
+    if (g_ItemManager.SpawnTransfer(&self->positionCenter, ITEM_POWER_SMALL, best, 20))
+    {
+        g_GameManager.AddSeatStock(power, -20);
+        th07::mp::Log("PLAYER_GIVE_POWER from=%d to=%d", seat, best);
+    }
+}
