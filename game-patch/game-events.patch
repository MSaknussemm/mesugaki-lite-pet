+static unsigned short SupportMask(int seat, unsigned frame)
+{
+    static int supportEnabled = -1;
+    if (supportEnabled < 0)
+    {
+        char v[8] = {};
+        supportEnabled = GetEnvironmentVariableA("TH07_MP_BOT_SUPPORT", v, sizeof(v)) > 0 && v[0] == '1';
+    }
+    if (!supportEnabled) return 0;
+    Player *self = &g_Players[seat];
+    if (IsGhost(self)) return 0;
+    const int lives = (int)g_GameManager.Lives(seat);
+    if ((frame % 60u) == 0u)
+    {
+        float d0 = 99999.0f;
+        int ghost0 = -1;
+        if (PlayerCount() > 1)
+        {
+            float dx = g_Players[0].positionCenter.x - self->positionCenter.x;
+            float dy = g_Players[0].positionCenter.y - self->positionCenter.y;
+            d0 = dx * dx + dy * dy;
+            ghost0 = IsGhost(&g_Players[0]);
+        }
+        th07::mp::Log("SUPPORT seat=%d lives=%d ghost0=%d d0=%.1f", seat, lives, ghost0, d0);
+    }
+    // High priority: revive a ghost teammate while we still have spare lives.
+    if (lives > 1)
+    {
+        for (int other = 0; other < PlayerCount(); other++)
+        {
+            if (other == seat) continue;
+            Player *mate = &g_Players[other];
+            if (!IsGhost(mate)) continue;
+            float dx = mate->positionCenter.x - self->positionCenter.x;
+            float dy = mate->positionCenter.y - self->positionCenter.y;
+            if (dx * dx + dy * dy > 24.0f * 24.0f)
+            {
+                unsigned out = 0;
+                if (dx > 4.0f) out |= TH_BUTTON_RIGHT; else if (dx < -4.0f) out |= TH_BUTTON_LEFT;
+                if (dy > 4.0f) out |= TH_BUTTON_DOWN; else if (dy < -4.0f) out |= TH_BUTTON_UP;
+                return (unsigned short)out;
+            }
+            // In range: release shot and hold focus for the 90-frame transfer.
+            return (unsigned short)TH_BUTTON_FOCUS;
+        }
+    }
+    // Lower priority: hand power to a teammate who is short.
+    if ((int)g_GameManager.Power(seat) >= 60)
+    {
+        for (int other = 0; other < PlayerCount(); other++)
+        {
+            if (other == seat) continue;
+            Player *mate = &g_Players[other];
+            if (IsGhost(mate) || (int)g_GameManager.Power(other) >= 100) continue;
+            float dx = mate->positionCenter.x - self->positionCenter.x;
+            float dy = mate->positionCenter.y - self->positionCenter.y;
+            if (dx * dx + dy * dy > 24.0f * 24.0f)
+            {
+                unsigned out = 0;
+                if (dx > 4.0f) out |= TH_BUTTON_RIGHT; else if (dx < -4.0f) out |= TH_BUTTON_LEFT;
+                if (dy > 4.0f) out |= TH_BUTTON_DOWN; else if (dy < -4.0f) out |= TH_BUTTON_UP;
+                return (unsigned short)out;
+            }
+            return (unsigned short)((frame % 4u) < 2u ? TH_BUTTON_SHOOT : 0);
+        }
+    }
+    return 0;
+}
